    "# ── Verificación de precisión: Tercera Ley de Kepler ──\n",
    "# T² = a³ (en unidades AU y años, cuando M_estrella ≈ 1 M☉)\n",
    "print('VERIFICACIÓN — TERCERA LEY DE KEPLER: T² = a³')\n",
    "print('=' * 60)\n",
    "print(f'{\"Planeta\":<12} {\"a_ref [AU]\":>12} {\"T_Kepler [años]\":>16} {\"T_sim [años]\":>14} {\"Error %\":>9}')\n",
    "print('-' * 60)\n",
    "\n",
    "# Estimamos período desde la simulación detectando cruces por el eje Y\n",
    "for i, (nombre, _, a_ref, e, _, _) in enumerate(SOLAR_SYSTEM[1:], start=1):\n",
    "    T_kepler = a_ref ** 1.5  # tercera ley: T = a^(3/2) en años\n",
    "\n",
    "    # Contar vueltas en la simulación (cruces del eje X positivo con y>0→y<0)\n",
    "    xs = np.array(trayectorias[nombre]['x'])\n",
    "    ys = np.array(trayectorias[nombre]['y'])\n",
    "    cruces = []\n",
    "    for j in range(1, len(ys)):\n",
    "        if ys[j-1] > 0 and ys[j] < 0 and xs[j] > 0:\n",
    "            cruces.append(tiempos[j])\n",
    "\n",
    "    if len(cruces) >= 2:\n",
    "        T_sim = cruces[-1] - cruces[0]\n",
    "        if len(cruces) > 2:\n",
    "            T_sim /= (len(cruces) - 1)\n",
    "        error = abs(T_sim - T_kepler) / T_kepler * 100\n",
    "    elif len(cruces) == 1 and a_ref > 5:  # planetas lentos, 1 cruce en 2 años\n",
