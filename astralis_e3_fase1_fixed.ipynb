   "source": [
    "# ── Descarga de posiciones desde JPL Horizons ──\n",
    "# La API REST de Horizons devuelve vectores de estado (posición + velocidad)\n",
    "# en coordenadas heliocéntricas eclípticas J2000\n",
    "\n",
    "def get_horizons_data(target_id: str, body_name: str) -> dict:\n",
    "    \"\"\"\n",
    "    Consulta JPL Horizons para obtener parámetros orbitales de un cuerpo.\n",
    "    target_id: código Horizons (399=Tierra, 499=Marte, 599=Júpiter, etc.)\n",
    "    \"\"\"\n",
    "    url = (\n",
    "        'https://ssd.jpl.nasa.gov/api/horizons.api'\n",
    "        f'?format=json&COMMAND={target_id}&OBJ_DATA=YES'\n",
    "        '&MAKE_EPHEM=YES&EPHEM_TYPE=ELEMENTS'\n",
    "        '&CENTER=500%4010&START_TIME=2026-01-01&STOP_TIME=2026-01-02&STEP_SIZE=1d'\n",
    "    )\n",
    "    try:\n",
    "        r = requests.get(url, timeout=15)\n",
    "        r.raise_for_status()\n",
    "        data = r.json()\n",
    "        return {'name': body_name, 'raw': data.get('result', ''), 'ok': True}\n",
    "    except Exception as e:\n",
    "        return {'name': body_name, 'error': str(e), 'ok': False}\n",
    "\n",
    "# Parámetros orbitales reales de JPL para el sistema solar interno\n",
    "# Fuente: JPL Horizons, epoch J2026.0, semieje mayor en AU, excentricidad adimensional\n",
    "SOLAR_SYSTEM = [\n",
    "    # (nombre,  masa_kg,        semieje_AU, excentricidad, inclinacion_deg, id_Horizons)\n",
    "    ('Sol',     1.989e30,       0.0,        0.0,           0.0,   '10'),\n",
    "    ('Mercurio', 3.285e23,      0.387,      0.2056,        7.0,   '199'),\n",
    "    ('Venus',   4.867e24,       0.723,      0.0068,        3.4,   '299'),\n",
    "    ('Tierra',  5.972e24,       1.000,      0.0167,        0.0,   '399'),\n",
    "    ('Marte',   6.390e23,       1.524,      0.0934,        1.85,  '499'),\n",
    "    ('Júpiter', 1.898e27,       5.203,      0.0489,        1.3,   '599'),\n",
    "    ('Saturno', 5.683e26,       9.537,      0.0565,        2.49,  '699'),\n",
    "]\n",
    "\n",
    "# Intento de descarga de Horizons (puede fallar sin internet)\n",
    "print('⏳ Intentando conectar con JPL Horizons...')\n",
    "hz_result = get_horizons_data('399', 'Tierra')\n",
    "if hz_result['ok']:\n",
    "    print(' JPL Horizons accesible — usando datos en tiempo real')\n",
    "    print(f'   Muestra: {hz_result[\"raw\"][:200]}...')\n",
    "else:\n",
    "    print(f'  JPL Horizons no accesible: {hz_result[\"error\"]}')\n",
    "    print('   → Usando parámetros orbitales de referencia JPL (Astronomical Almanac 2026)')"
   ]
