   "source": [
    "# ── Integración: simular 2 años con 500 pasos ──\n",
    "T_TOTAL  = 2.0   # años\n",
    "N_PASOS  = 500\n",
    "tiempos  = np.linspace(0, T_TOTAL, N_PASOS)\n",
    "n_bodies = sim.N\n",
    "\n",
    "# Guardar trayectorias\n",
    "trayectorias = {SOLAR_SYSTEM[i][0]: {'x': [], 'y': [], 'dist': []} for i in range(n_bodies)}\n",
    "\n",
    "for t in tiempos:\n",
    "    sim.integrate(t)\n",
    "    for i, p in enumerate(sim.particles):\n",
    "        nombre = SOLAR_SYSTEM[i][0]\n",
    "        trayectorias[nombre]['x'].append(p.x)\n",
    "        trayectorias[nombre]['y'].append(p.y)\n",
    "        trayectorias[nombre]['dist'].append(np.sqrt(p.x**2 + p.y**2 + p.z**2))\n",
    "\n",
    "print(f' Simulación completada: {T_TOTAL} años orbitales, {N_PASOS} pasos')"
   ]
  },
