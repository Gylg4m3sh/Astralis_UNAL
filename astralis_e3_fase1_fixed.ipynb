   "source": [
    "# ── Visualización de la trayectoria de la ISS ──\n",
    "# Datos de referencia de la órbita de la ISS\n",
    "ISS_ALTITUD_KM   = 408    # km sobre la superficie\n",
    "ISS_PERIODO_MIN  = 92.9   # minutos por órbita\n",
    "ISS_INCLINACION  = 51.6   # grados\n",
    "R_TIERRA_KM      = 6371   # km\n",
    "\n",
    "# Simular una órbita completa de la ISS (proyección en lat/lon)\n",
    "t_orbit = np.linspace(0, 2 * np.pi, 500)  # una vuelta completa\n",
    "lon_iss = np.degrees(t_orbit) - 180       # longitud simplificada\n",
    "lat_iss = ISS_INCLINACION * np.sin(t_orbit)  # aproximación de la inclinación\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(13, 6), facecolor='#0A1628')\n",
    "ax.set_facecolor('#0A1628')\n",
    "\n",
    "# Fondo tipo mapa\n",
    "ax.axhline(0, color='#1E88E5', alpha=0.3, linewidth=0.8, linestyle='--')  # ecuador\n",
    "for lat_line in [-60, -30, 30, 60]:\n",
    "    ax.axhline(lat_line, color='#263238', alpha=0.5, linewidth=0.5)\n",
    "for lon_line in range(-180, 181, 60):\n",
    "    ax.axvline(lon_line, color='#263238', alpha=0.5, linewidth=0.5)\n",
    "\n",
    "# Trayectoria ISS\n",
    "ax.plot(lon_iss, lat_iss, color='#FF6B6B', linewidth=1.5, alpha=0.8, label='Órbita ISS (1 vuelta)')\n",
    "\n",
    "# Posiciones capturadas\n",
    "for j, pos in enumerate(posiciones):\n",
    "    # ✅ FIX: variable marker con emojis eliminada — matplotlib no los soporta como marcadores\n",
    "    color = '#00E5FF' if pos['ok'] else '#FF5252'\n",
    "    ax.scatter(pos['lon'], pos['lat'], s=120, c=color, zorder=10,\n",
    "               edgecolors='white', linewidths=1)\n",
    "    label = f'ISS t+{j*2}s' if pos['ok'] else f'(sin conexión)'\n",
    "    ax.annotate(label, (pos['lon'], pos['lat']),\n",
    "                xytext=(8, 8), textcoords='offset points',\n",
    "                color=color, fontsize=9, fontweight='bold')\n",
    "\n",
    "# Bogotá como referencia\n",
    "ax.scatter(-74.08, 4.71, s=80, c='#FFEB3B', zorder=10, marker='*')\n",
    "ax.annotate('Bogotá', (-74.08, 4.71), xytext=(5, -15), textcoords='offset points',\n",
    "            color='#FFEB3B', fontsize=8)\n",
    "\n",
    "ax.set_xlim(-180, 180)\n",
    "ax.set_ylim(-90, 90)\n",
    "ax.set_xlabel('Longitud (°)', color='white')\n",
    "ax.set_ylabel('Latitud (°)', color='white')\n",
    "ax.tick_params(colors='white')\n",
    "ax.set_title(\n",
    "    f'Posición ISS en tiempo real — Altitud: {ISS_ALTITUD_KM} km · Período: {ISS_PERIODO_MIN} min · Inclinación: {ISS_INCLINACION}°',\n",
    "    color='white', fontsize=11, fontweight='bold'\n",
    ")\n",
    "ax.legend(facecolor='#1A237E', labelcolor='white', fontsize=9)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('iss_trayectoria.png', dpi=120, bbox_inches='tight', facecolor='#0A1628')\n",
    "plt.show()\n",
    "\n",
    "print(f'\\nDatos de la órbita ISS (referencia JPL/NASA):')\n",
    "print(f'  Altitud:          {ISS_ALTITUD_KM} km')\n",
    "print(f'  Velocidad:        ~7.66 km/s')\n",
    "print(f'  Período orbital:  {ISS_PERIODO_MIN} minutos')\n",
    "print(f'  Vueltas/día:      {24*60/ISS_PERIODO_MIN:.1f}')\n",
    "print(f'  Inclinación:      {ISS_INCLINACION}°')"
   ]
