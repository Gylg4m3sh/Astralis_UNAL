   ],
   "source": [
    "# ── Construcción de la simulación N-cuerpos ──\n",
    "M_SOL = 1.989e30   # kg\n",
    "G     = 6.674e-11  # m³/(kg·s²)\n",
    "\n",
    "sim = rebound.Simulation()\n",
    "sim.G = 4 * np.pi**2  # unidades astronómicas: G=4π² → T en años, a en AU\n",
    "sim.integrator = 'ias15'  # integrador adaptativo de alta precisión\n",
    "\n",
    "# Agregar cuerpos con parámetros orbitales reales\n",
    "for nombre, masa_kg, a, e, inc_deg, _ in SOLAR_SYSTEM:\n",
    "    masa_solar = masa_kg / M_SOL\n",
    "    if nombre == 'Sol':\n",
    "        sim.add(m=masa_solar)\n",
    "    else:\n",
    "        sim.add(\n",
    "            m=masa_solar,\n",
    "            a=a,\n",
    "            e=e,\n",
    "            inc=np.radians(inc_deg),\n",
    "            primary=sim.particles[0]\n",
    "        )\n",
    "\n",
    "sim.move_to_com()  # centrar en el centro de masa del sistema\n",
    "\n",
    "print(f' Simulación inicializada con {sim.N} cuerpos')\n",
    "print(f'   Integrador: {sim.integrator}')\n",
    "print(f'   Unidades: AU, años, M☉')\n",
    "print()\n",
    "print('Posiciones iniciales (t=0):')\n",
    "print(f'{\"Cuerpo\":<12} {\"x [AU]\":>10} {\"y [AU]\":>10} {\"z [AU]\":>10} {\"dist. al Sol [AU]\":>18}')\n",
    "print('-' * 62)\n",
    "for i, p in enumerate(sim.particles):\n",
    "    nombre = SOLAR_SYSTEM[i][0]\n",
    "    dist = np.sqrt(p.x**2 + p.y**2 + p.z**2)\n",
    "    print(f'{nombre:<12} {p.x:>10.4f} {p.y:>10.4f} {p.z:>10.4f} {dist:>18.4f}')"
   ]
  },
