    "---\n",
    "## 2. Descarga del dataset NASA Exoplanet Archive\n",
    "\n",
    "El **NASA Exoplanet Archive** expone una API TAP (Table Access Protocol) que permite consultar directamente con SQL.  \n",
    "La tabla `cumulative` contiene todos los candidatos del telescopio Kepler con sus parámetros orbitales, estelares y de tránsito.\n",
    "\n",
    "**Columnas seleccionadas y su significado astronómico:**\n",
    "\n",
    "| Columna | Significado | Unidad |\n",
    "|---|---|---|\n",
    "| `koi_period` | Período orbital (tiempo en completar una órbita) | días |\n",
    "| `koi_prad` | Radio del planeta (comparado con la Tierra) | R⊕ |\n",
    "| `koi_teq` | Temperatura de equilibrio del planeta | K |\n",
    "| `koi_insol` | Insolación (flujo de energía que recibe el planeta) | F⊕ |\n",
    "| `koi_steff` | Temperatura efectiva de la estrella anfitriona | K |\n",
    "| `koi_slogg` | Logaritmo de la gravedad superficial de la estrella | log(cm/s²) |\n",
    "| `koi_srad` | Radio de la estrella | R☉ |\n",
    "| `koi_smass` | Masa de la estrella | M☉ |\n",
    "| `koi_duration` | Duración del tránsito (tiempo que tarda el planeta en cruzar la estrella) | horas |\n",
    "| `koi_depth` | Profundidad del tránsito (cuánto oscurece el planeta a la estrella) | ppm |\n",
    "| `koi_impact` | Parámetro de impacto (qué tan central es el tránsito, 0=centro) | adimensional |\n",
    "| `koi_incl` | Inclinación orbital (90° = perfectamente de frente) | grados |\n",
    "| `koi_disposition` | **Variable objetivo**: CONFIRMED o FALSE POSITIVE | — |"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " Descargando dataset desde NASA Exoplanet Archive...\n",
      " Dataset descargado y guardado: 7,586 registros, 14 columnas\n",
      "\n",
      " Fuente de datos: NASA API\n",
      "   Total de registros: 7,586\n"
     ]
    }
   ],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# DESCARGA REAL desde NASA Exoplanet Archive\n",
    "# Descomenta este bloque cuando tengas acceso a internet\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "FEATURES = [\n",
    "    'kepoi_name', 'koi_disposition',\n",
    "    'koi_period', 'koi_prad', 'koi_teq', 'koi_insol',\n",
    "    'koi_steff', 'koi_slogg', 'koi_srad', 'koi_smass',\n",
    "    'koi_duration', 'koi_depth', 'koi_impact', 'koi_incl'\n",
    "]\n",
    "\n",
    "cols_query = ','.join(FEATURES)\n",
    "\n",
    "NASA_PARAMS = {\n",
    "    'query': f\"select {cols_query} from cumulative where koi_disposition in ('CONFIRMED','FALSE POSITIVE')\",\n",
    "    'format': 'csv'\n",
    "}\n",
    "NASA_BASE_URL = 'https://exoplanetarchive.ipac.caltech.edu/TAP/sync'\n",
    "\n",
    "try:\n",
    "    print(' Descargando dataset desde NASA Exoplanet Archive...')\n",
    "    response = requests.get(NASA_BASE_URL, params=NASA_PARAMS, timeout=60)\n",
    "    response.raise_for_status()\n",
    "    df = pd.read_csv(io.StringIO(response.text))\n",
    "    df.to_csv('kepler_candidates.csv', index=False)\n",
    "    print(f' Dataset descargado y guardado: {df.shape[0]:,} registros, {df.shape[1]} columnas')\n",
    "    DATA_SOURCE = 'NASA API'\n",
    "\n",
    "except Exception as e:\n",
    "    print(f' No se pudo conectar a la NASA API: {e}')\n",
    "    print('   → Usando dataset sintético con distribuciones basadas en Kepler DR25')\n",
    "    DATA_SOURCE = 'sintético (distribuciones Kepler DR25)'\n",
    "\n",
    "    #Si no llega a ver internet, generamos un dataset sintético con distribuciones calibradas a partir de los datos reales de Kepler Data Release 25 (DR25). Esto nos permitirá simular un escenario realista para el análisis y modelado, aunque con la ventaja de controlar las características de los datos.\n",
    "    # ─────────────────────────────────────────────────────────────────────────\n",
    "    # DATASET SINTÉTICO — distribuciones calibradas con Kepler Data Release 25\n",
    "    # Confirmed:    2,327 objetos reales en el catálogo\n",
    "    # False Positive: 3,598 objetos reales en el catálogo\n",
    "    # ─────────────────────────────────────────────────────────────────────────\n",
    "    np.random.seed(42)\n",
    "    N_CONF, N_FP = 2327, 3598\n",
    "\n",
    "    confirmed = pd.DataFrame({\n",
    "        'kepoi_name':      [f'K{i:05d}.01' for i in range(N_CONF)],\n",
    "        'koi_disposition': 'CONFIRMED',\n",
    "        # Período: planetas confirmados tienden a ser más cortos (hot Jupiters y super-Tierras)\n",
    "        'koi_period':   np.random.lognormal(2.5, 1.2, N_CONF),\n",
    "        # Radio: mayoría son super-Tierras (1-4 R⊕)\n",
    "        'koi_prad':     np.clip(np.random.lognormal(0.8, 0.7, N_CONF), 0.3, 25),\n",
    "        # Temperatura de equilibrio: distribución térmica realista\n",
    "        'koi_teq':      np.clip(np.random.normal(800, 400, N_CONF), 100, 4000),\n",
    "        'koi_insol':    np.clip(np.random.lognormal(3.0, 2.0, N_CONF), 0.1, 1e6),\n",
    "        # Parámetros estelares: estrellas tipo G y K (similares al Sol)\n",
    "        'koi_steff':    np.clip(np.random.normal(5600, 500, N_CONF), 3500, 8000),\n",
    "        'koi_slogg':    np.clip(np.random.normal(4.4, 0.3, N_CONF), 3.0, 5.0),\n",
    "        'koi_srad':     np.clip(np.random.lognormal(0.05, 0.3, N_CONF), 0.2, 5.0),\n",
    "        'koi_smass':    np.clip(np.random.lognormal(0.0, 0.2, N_CONF), 0.3, 3.0),\n",
    "        # Tránsito: planetas reales tienen tránsitos limpios y consistentes\n",
    "        'koi_duration': np.clip(np.random.lognormal(2.0, 0.6, N_CONF), 0.5, 20),\n",
    "        'koi_depth':    np.clip(np.random.lognormal(5.5, 1.5, N_CONF), 10, 1e5),\n",
    "        # Parámetro de impacto: planetas confirmados tienden a tránsitos más centrales\n",
    "        'koi_impact':   np.clip(np.random.beta(1, 3, N_CONF), 0, 1),\n",
    "        'koi_incl':     np.clip(np.random.normal(88.5, 2.5, N_CONF), 70, 90),\n",
    "    })\n",
    "\n",
    "    false_pos = pd.DataFrame({\n",
    "        'kepoi_name':      [f'K{i:05d}.02' for i in range(N_FP)],\n",
    "        'koi_disposition': 'FALSE POSITIVE',\n",
    "        # Falsos positivos: más erráticos, períodos y radios más dispersos\n",
    "        'koi_period':   np.random.lognormal(3.2, 1.5, N_FP),\n",
    "        'koi_prad':     np.clip(np.random.lognormal(1.5, 1.0, N_FP), 0.3, 50),\n",
    "        'koi_teq':      np.clip(np.random.normal(600, 600, N_FP), 100, 4000),\n",
    "        'koi_insol':    np.clip(np.random.lognormal(2.0, 2.5, N_FP), 0.1, 1e6),\n",
    "        'koi_steff':    np.clip(np.random.normal(5400, 700, N_FP), 3500, 8000),\n",
    "        'koi_slogg':    np.clip(np.random.normal(4.2, 0.5, N_FP), 3.0, 5.0),\n",
    "        'koi_srad':     np.clip(np.random.lognormal(0.15, 0.5, N_FP), 0.2, 8.0),\n",
    "        'koi_smass':    np.clip(np.random.lognormal(0.05, 0.3, N_FP), 0.3, 4.0),\n",
    "        'koi_duration': np.clip(np.random.lognormal(2.3, 0.9, N_FP), 0.5, 30),\n",
    "        'koi_depth':    np.clip(np.random.lognormal(6.5, 2.0, N_FP), 10, 5e5),\n",
    "        # FP tienden a tener parámetro de impacto más alto (tránsitos rasantes)\n",
    "        'koi_impact':   np.clip(np.random.beta(2, 2, N_FP), 0, 1),\n",
    "        'koi_incl':     np.clip(np.random.normal(84, 8, N_FP), 60, 90),\n",
    "    })\n",
    "\n",
    "    df = pd.concat([confirmed, false_pos], ignore_index=True).sample(frac=1, random_state=42).reset_index(drop=True)\n",
    "\n",
    "print(f'\\n Fuente de datos: {DATA_SOURCE}')\n",
    "print(f'   Total de registros: {len(df):,}')"
   ]
  },
