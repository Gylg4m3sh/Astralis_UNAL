    "import time\n",
    "\n",
    "def get_iss_position() -> dict:\n",
    "    \"\"\"Obtiene la posición actual de la ISS desde Open Notify API.\"\"\"\n",
    "    try:\n",
    "        r = requests.get('http://api.open-notify.org/iss-now.json', timeout=10)\n",
    "        r.raise_for_status()\n",
    "        data = r.json()\n",
    "        return {\n",
    "            'ok': True,\n",
    "            'lat':       float(data['iss_position']['latitude']),\n",
    "            'lon':       float(data['iss_position']['longitude']),\n",
    "            'timestamp': data['timestamp'],\n",
    "            'mensaje':   data['message']\n",
    "        }\n",
    "    except Exception as e:\n",
    "        return {'ok': False, 'error': str(e)}\n",
    "\n",
    "# Capturar 3 posiciones con 2 segundos de intervalo\n",
    "print('📡 Consultando posición de la ISS...')\n",
    "posiciones = []\n",
    "\n",
    "for i in range(3):\n",
    "    pos = get_iss_position()\n",
    "    if pos['ok']:\n",
    "        posiciones.append(pos)\n",
    "        print(f'  [{i+1}] Lat: {pos[\"lat\"]:>8.4f}°  Lon: {pos[\"lon\"]:>9.4f}°  (t={pos[\"timestamp\"]})')\n",
    "    else:\n",
    "        print(f'  [{i+1}]   No se pudo conectar: {pos[\"error\"]}')\n",
    "        posiciones.append({'ok': False, 'lat': 0 + i*0.5, 'lon': 0 + i*0.5})\n",
    "    if i < 2:\n",
    "        time.sleep(2)\n",
    "\n",
    "# Calcular velocidad angular aproximada entre mediciones\n",
    "if len(posiciones) >= 2 and all(p['ok'] for p in posiciones[:2]):\n",
    "    dlat = posiciones[1]['lat'] - posiciones[0]['lat']\n",
    "    dlon = posiciones[1]['lon'] - posiciones[0]['lon']\n",
    "    dist_aprox = np.sqrt(dlat**2 + dlon**2)\n",
    "    print(f'\\n  Desplazamiento en 2 s: Δlat={dlat:.4f}°, Δlon={dlon:.4f}°')\n",
    "    print(f'  La ISS viaja a ~7.66 km/s → ~0.068°/s de longitud en el ecuador')"
   ]
