   "source": [
    "conf = df[df['koi_disposition'] == 'CONFIRMED']\n",
    "fp   = df[df['koi_disposition'] == 'FALSE POSITIVE']\n",
    "\n",
    "print('COMPARACIÓN DE MEDIAS POR CLASE')\n",
    "print('=' * 65)\n",
    "print(f'{\"Feature\":<18} {\"CONFIRMED\":>12} {\"FALSE POS\":>12} {\"Diferencia\":>12}')\n",
    "print('-' * 65)\n",
    "\n",
    "comparisons = [\n",
    "    ('koi_period',   'días',         'Período orbital'),\n",
    "    ('koi_prad',     'R⊕',           'Radio planeta'),\n",
    "    ('koi_teq',      'K',            'Temperatura eq.'),\n",
    "    ('koi_steff',    'K',            'Temp. estrella'),\n",
    "    ('koi_srad',     'R☉',           'Radio estrella'),\n",
    "    ('koi_duration', 'h',            'Dur. tránsito'),\n",
    "    ('koi_depth',    'ppm',          'Prof. tránsito'),\n",
    "    ('koi_impact',   '',             'Param. impacto'),\n",
    "    ('koi_incl',     '°',            'Inclinación'),\n",
    "]\n",
    "\n",
    "for col, unit, label in comparisons:\n",
    "    m_c = conf[col].mean()\n",
    "    m_f = fp[col].mean()\n",
