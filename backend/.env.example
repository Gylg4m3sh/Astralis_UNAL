# Copia este archivo como .env y completa los valores

# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/astralis

# JWT — genera un valor seguro con: openssl rand -hex 32
SECRET_KEY=cambia_esto_por_algo_seguro
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — URL de tu frontend Vite
FRONTEND_URL=http://localhost:5173

# URL del microservicio ML de E3 (cuando esté listo)
ML_SERVICE_URL=http://localhost:8001
